{
  "shared": {
    "model_name": "gpt-4o",
    "base_url": "https://api.openai.com/v1",
    "provider": "openai",
    "context_window": 128000
  },
  "experiments": {
    "root_dir": "runs"
  },
  "environment": {
    "dataset": "",
    "online_arcade": true,
    "include_tags": [],
    "exclude_tags": [],
    "games": ["vc33-5430563c"],
    "max_steps": 90,
    "max_runtime_minutes": 60,
    "max_experiment_runtime_minutes": 65,
    "n_passes": 1,
    "concurrent_jobs": 1
  },
  "deployment": {
    "target": "inline",
    "wait": true,
    "source_repos": ["../tufa-arc-agi-framework"]
  },
  "analyzer": {
    "app_name": "Virelai G3 vc33 Focused Checkpoint",
    "max_output": 2048,
    "thinking": true,
    "temperature": 0.6,
    "top_p": 0.95,
    "timeout": 180,
    "tool_steps": 12,
    "tool_timeout": 30,
    "tool_output_tokens": 1024,
    "save_request_logs": true
  },
  "multimodal": {
    "context": "current_grid",
    "upscale": 16
  }
}
