7.4s 170 print('vLLM server ready:', models, flush=True)
7.4s 171 return
7.4s 172 except Exception:
7.4s 173 time.sleep(5)
7.4s 174 raise TimeoutError(f'Timed out waiting for vLLM server at {url}.\nLast server log lines:\n{tail_server_log()}')
