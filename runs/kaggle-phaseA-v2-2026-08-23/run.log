7.4s 73 assert result.returncode == 0, f'nvidia-smi failed: {result.stderr.strip()}'
7.4s 74 gpu_names = [line.strip() for line in result.stdout.splitlines() if line.strip()]
7.4s 75 assert gpu_names, 'nvidia-smi did not report any CUDA GPUs.'
