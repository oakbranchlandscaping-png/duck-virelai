7.4s 146 def request_json(url: str, payload: dict | None = None, timeout: int = 30) -> dict:
7.4s 147 data = None if payload is None else json.dumps(payload).encode('utf-8')
7.4s 148 request = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'})
