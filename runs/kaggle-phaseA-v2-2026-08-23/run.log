7.4s 68 def assert_expected_cuda_gpu() -> None:
7.4s 69 if not Path('/kaggle/input').exists():
7.4s 70 return
7.4s 71 assert shutil.which('nvidia-smi'), 'CUDA GPU check failed: nvidia-smi is not available.'
